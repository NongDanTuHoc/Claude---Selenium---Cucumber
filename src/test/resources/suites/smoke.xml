<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Test Suite" parallel="false" configfailurepolicy="skip">

    <listeners>
        <listener class-name="com.company.automation.listeners.TestNGSuiteListener"/>
        <listener class-name="com.company.automation.listeners.TestNGMethodListener"/>
    </listeners>

    <packages>
        <package name="com.company.automation.pages.*"/>
        <package name="com.company.automation.api.*"/>
    </packages>

    <groups>
        <run>
            <include name="smoke"/>
        </run>
    </groups>

    <method-selectors>
        <method-selector>
            <selector-class name="org.testng.methods.MethodSelector"/>
        </method-selector>
    </method-selectors>

    <suite-files>
        <!-- Optionally include additional suite files -->
    </suite-files>

</suite>
