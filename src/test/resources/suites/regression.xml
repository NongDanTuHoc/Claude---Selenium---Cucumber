<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Test Suite" parallel="classes" thread-count="4" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.company.automation.listeners.TestNGSuiteListener"/>
        <listener class-name="com.company.automation.listeners.TestNGMethodListener"/>
    </listeners>

    <packages>
        <package name="com.company.automation.pages.*"/>
        <package name="com.company.automation.api.*"/>
        <package name="com.company.automation.db.*"/>
    </packages>

    <groups>
        <run>
            <include name="smoke"/>
            <include name="regression"/>
        </run>
    </groups>

</suite>
